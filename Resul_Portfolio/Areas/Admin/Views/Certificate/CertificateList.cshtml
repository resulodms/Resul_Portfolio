@model List<Certificate>
@{
    ViewData["Title"] = "Sertifikalar";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="list-card">
    <div class="list-card-header">
        <div class="d-flex align-items-center gap-3">
            <div class="list-card-icon"><i class="bi bi-award"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Sertifikalar</h5>
                <small class="text-secondary">
                    Toplam @Model.Count sertifika ·
                    <span class="text-success fw-semibold">@Model.Count(x => x.IsActive) aktif</span>
                </small>
            </div>
        </div>
        <a asp-area="Admin" asp-controller="Certificate" asp-action="CreateCertificate" class="btn btn-add">
            <i class="bi bi-plus-lg me-1"></i> Yeni Sertifika
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-award"></i></div>
            <h6 class="fw-bold mb-1">Henüz sertifika eklenmedi</h6>
            <p class="text-secondary small mb-3">Aktif sertifikalar portfolyoda tarih sırasına göre listelenir.</p>
            <a asp-area="Admin" asp-controller="Certificate" asp-action="CreateCertificate" class="btn btn-add">
                <i class="bi bi-plus-lg me-1"></i> İlk Sertifikayı Ekle
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table list-table">
                <thead>
                    <tr>
                        <th>Sertifika</th>
                        <th>Kurum</th>
                        <th>Tarih</th>
                        <th>Bağlantı</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Title</td>
                            <td>@item.Issuer</td>
                            <td class="text-nowrap text-secondary">@item.IssueDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.CertificateUrl))
                                {
                                    <a href="@item.CertificateUrl" target="_blank" rel="noopener noreferrer" class="btn-icon edit" title="Sertifikayı aç">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-secondary small">-</span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="status-pill"><i class="bi bi-check-circle-fill"></i> Aktif</span>
                                }
                                else
                                {
                                    <span class="status-pill" style="background:#F1F2F6;color:#6B7489;border-color:#DFE2EA;"><i class="bi bi-eye-slash-fill"></i> Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-area="Admin" asp-controller="Certificate" asp-action="UpdateCertificate" asp-route-id="@item.CertificateId"
                                       class="btn-icon edit" title="Güncelle"><i class="bi bi-pencil-square"></i></a>
                                    <button type="button" class="btn-icon delete" title="Sil"
                                            onclick="deleteCertificate(@item.CertificateId, '@item.Title.Replace("'", "")')">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        function deleteCertificate(id, name) {
            Swal.fire({
                icon: "warning",
                title: "Emin misiniz?",
                text: "\"" + name + "\" sertifikası kalıcı olarak silinecek.",
                showCancelButton: true,
                confirmButtonText: "Evet, sil",
                cancelButtonText: "Vazgeç",
                confirmButtonColor: "#D9534F",
                reverseButtons: true
            }).then(result => {
                if (result.isConfirmed) {
                    window.location.href = "/Admin/Certificate/DeleteCertificate/" + id;
                }
            });
        }
    </script>
}