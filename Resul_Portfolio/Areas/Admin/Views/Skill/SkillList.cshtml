@model List<Skill>
@{
    ViewData["Title"] = "Yetenekler";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="list-card">
    <!-- Başlık -->
    <div class="list-card-header">
        <div class="d-flex align-items-center gap-3">
            <div class="list-card-icon"><i class="bi bi-code-slash"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Yetenekler</h5>
                <small class="text-secondary">
                    Toplam @Model.Count yetenek ·
                    @Model.Select(x => x.GroupName).Distinct().Count() grup ·
                    <span class="text-success fw-semibold">@Model.Count(x => x.IsActive) aktif</span>
                </small>
            </div>
        </div>

        <a asp-area="Admin" asp-controller="Skill" asp-action="CreateSkill" class="btn btn-add">
            <i class="bi bi-plus-lg me-1"></i> Yeni Yetenek
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-code-slash"></i></div>
            <h6 class="fw-bold mb-1">Henüz yetenek eklenmedi</h6>
            <p class="text-secondary small mb-3">Yetenekler portfolyoda grup kartları halinde, yüzde bilgisiyle görünür.</p>
            <a asp-area="Admin" asp-controller="Skill" asp-action="CreateSkill" class="btn btn-add">
                <i class="bi bi-plus-lg me-1"></i> İlk Yeteneği Ekle
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table list-table">
                <thead>
                    <tr>
                        <th>Yetenek</th>
                        <th>Grup</th>
                        <th style="min-width: 180px;">Seviye</th>
                        <th>Sıra</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td><span class="badge rounded-pill text-bg-light border">@item.GroupName</span></td>
                            <td>
                                @* Yüzde bilgisi: progress bar + sayı *@
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 6px;">
                                        <div class="progress-bar" style="width: @item.Percentage%; background-color: var(--primary-accent);"></div>
                                    </div>
                                    <span class="small fw-semibold" style="width: 38px;">%@item.Percentage</span>
                                </div>
                            </td>
                            <td class="text-secondary">@item.DisplayOrder</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="status-pill"><i class="bi bi-check-circle-fill"></i> Aktif</span>
                                }
                                else
                                {
                                    <span class="status-pill" style="background:#F1F2F6;color:#6B7489;border-color:#DFE2EA;"><i class="bi bi-eye-slash-fill"></i> Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-area="Admin" asp-controller="Skill" asp-action="UpdateSkill" asp-route-id="@item.SkillId"
                                       class="btn-icon edit" title="Güncelle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <button type="button" class="btn-icon delete btn-delete"
                                            data-id="@item.SkillId" data-name="@item.Name" title="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll(".btn-delete").forEach(btn => {
            btn.addEventListener("click", function () {
                const id = this.dataset.id;
                const name = this.dataset.name;

                Swal.fire({
                    icon: "warning",
                    title: "Emin misiniz?",
                    text: "\"" + name + "\" yeteneği kalıcı olarak silinecek.",
                    showCancelButton: true,
                    confirmButtonText: "Evet, sil",
                    cancelButtonText: "Vazgeç",
                    confirmButtonColor: "#D9534F",
                    cancelButtonColor: "#8490A5",
                    reverseButtons: true
                }).then(result => {
                    if (result.isConfirmed) {
                        window.location.href = "/Admin/Skill/DeleteSkill/" + id;
                    }
                });
            });
        });
    </script>
}