@model List<Category>
@{
    ViewData["Title"] = "Kategoriler";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="list-card">
    <div class="list-card-header">
        <div class="d-flex align-items-center gap-3">
            <div class="list-card-icon"><i class="bi bi-tags"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Proje Kategorileri</h5>
                <small class="text-secondary">
                    @Model.Count kategori · toplam @Model.Sum(x => x.Projects.Count) proje.
                    Projesi olan kategori silinemez.
                </small>
            </div>
        </div>

        <a asp-area="Admin" asp-controller="Category" asp-action="CreateCategory" class="btn btn-add">
            <i class="bi bi-plus-lg me-1"></i> Yeni Kategori
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-tags"></i></div>
            <h6 class="fw-bold mb-1">Henüz kategori eklenmedi</h6>
            <p class="text-secondary small mb-3">Proje ekleyebilmek için önce en az bir kategori oluşturmalısınız.</p>
            <a asp-area="Admin" asp-controller="Category" asp-action="CreateCategory" class="btn btn-add">
                <i class="bi bi-plus-lg me-1"></i> İlk Kategoriyi Ekle
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table list-table">
                <thead>
                    <tr>
                        <th>Kategori Adı</th>
                        <th>Proje Sayısı</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var count = item.Projects.Count;
                        <tr>
                            <td class="fw-semibold">@item.CategoryName</td>
                            <td>
                                @if (count > 0)
                                {
                                    <span class="status-pill"><i class="bi bi-grid"></i> @count proje</span>
                                }
                                else
                                {
                                    <span class="text-secondary small">Proje yok</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-area="Admin" asp-controller="Category" asp-action="UpdateCategory" asp-route-id="@item.CategoryId"
                                       class="btn-icon edit" title="Güncelle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <button type="button" class="btn-icon delete btn-delete"
                                            data-id="@item.CategoryId" data-name="@item.CategoryName" data-count="@count" title="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll(".btn-delete").forEach(btn => {
            btn.addEventListener("click", function () {
                const id = this.dataset.id;
                const name = this.dataset.name;
                const count = parseInt(this.dataset.count);

                // Projesi olan kategori: sunucuya hiç gitmeden bilgilendir
                if (count > 0) {
                    Swal.fire({
                        icon: "info",
                        title: "Bu kategori silinemez",
                        text: "\"" + name + "\" kategorisinde " + count + " proje var. Önce projeleri başka bir kategoriye taşıyın veya silin.",
                        confirmButtonColor: "#8276D9"
                    });
                    return;
                }

                Swal.fire({
                    icon: "warning",
                    title: "Emin misiniz?",
                    text: "\"" + name + "\" kategorisi kalıcı olarak silinecek.",
                    showCancelButton: true,
                    confirmButtonText: "Evet, sil",
                    cancelButtonText: "Vazgeç",
                    confirmButtonColor: "#D9534F",
                    cancelButtonColor: "#8490A5",
                    reverseButtons: true
                }).then(result => {
                    if (result.isConfirmed) {
                        window.location.href = "/Admin/Category/DeleteCategory/" + id;
                    }
                });
            });
        });
    </script>
}