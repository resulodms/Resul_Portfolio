@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Girişi | Resul Ödemiş</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #F4F2FF 0%, #EAF3FF 100%);
        }

        .login-card {
            width: 100%;
            max-width: 410px;
            background: #fff;
            border-radius: 20px;
            padding: 36px 32px;
            box-shadow: 0 20px 50px rgba(130,118,217,.15);
            border: 1px solid #ECEAF7;
        }

        .brand-mark {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: linear-gradient(135deg, #8276D9, #A99CF0);
            color: #fff;
            font-family: 'Plus Jakarta Sans';
            font-weight: 800;
            font-size: 1.4rem;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 14px;
        }

        h1 {
            font-family: 'Plus Jakarta Sans';
            font-size: 1.35rem;
            font-weight: 700;
        }

        .form-control {
            border-radius: 12px;
            padding: 11px 14px;
        }

            .form-control:focus {
                border-color: #8276D9;
                box-shadow: 0 0 0 .2rem rgba(130,118,217,.18);
            }

        .input-group .btn {
            border-radius: 0 12px 12px 0;
        }

        .btn-login {
            background: #8276D9;
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 11px;
            font-weight: 600;
            width: 100%;
        }

            .btn-login:hover {
                background: #6F62CC;
                color: #fff;
            }

        .field-validation-error {
            color: #D9534F;
            font-size: .8rem;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <div class="brand-mark">R</div>
            <h1 class="mb-1">Yönetim Paneli</h1>
            <p class="text-secondary small mb-0">Devam etmek için giriş yapın</p>
        </div>

        <form asp-controller="Login" asp-action="Index" method="post">
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="mb-3">
                <label asp-for="UserName" class="form-label small fw-semibold">Kullanıcı Adı</label>
                <input asp-for="UserName" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="UserName"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-semibold">Şifre</label>
                <div class="input-group">
                    <input asp-for="Password" id="pwd" class="form-control" autocomplete="current-password" />
                    <button type="button" class="btn btn-outline-secondary" onclick="togglePwd()" tabindex="-1">
                        <i class="bi bi-eye" id="pwdIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label small">Beni hatırla</label>
            </div>

            <button type="submit" class="btn-login">
                <i class="bi bi-box-arrow-in-right me-1"></i> Giriş Yap
            </button>
        </form>

        <div class="text-center mt-4">
            <a href="/" class="small text-secondary text-decoration-none">
                <i class="bi bi-arrow-left"></i> Portfolyoya dön
            </a>
        </div>
    </div>

    <script>
        function togglePwd() {
            const input = document.getElementById("pwd");
            const icon = document.getElementById("pwdIcon");
            const show = input.type === "password";
            input.type = show ? "text" : "password";
            icon.className = show ? "bi bi-eye-slash" : "bi bi-eye";
        }
    </script>
</body>
</html>