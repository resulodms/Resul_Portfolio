                        @await Component.InvokeAsync("_DefaultSocialLinksComponentPartial")
                    </div>
                </div>
            </div>

            <hr class="text-secondary opacity-25 mb-4">

            <div class="text-center">
                <p class="text-secondary small mb-0">© 2026 Resul Ödemiş. Tüm hakları saklıdır.</p>
            </div>
        </div>
