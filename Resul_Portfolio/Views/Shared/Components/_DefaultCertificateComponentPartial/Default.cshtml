@model List<Certificate>
@{
    var colors = new[] { "bg-icon-purple", "bg-icon-blue", "bg-icon-mint", "bg-icon-peach" };
}

<!-- Certifications Section -->
<section id="certificates">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">SÜREKLİ ÖĞRENME</span>
            <h2 class="section-title">Sertifikalarım</h2>
            <p class="section-subtitle">Teknik becerilerimi geliştirmek için tamamladığım eğitimler.</p>
        </div>

        <div class="row g-4">
            @for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                <div class="col-lg-3 col-md-6 reveal-on-scroll">
                    <div class="certificate-card">
                        <div class="float-icon-box @colors[i % colors.Length] mb-3">
                            <i class="bi bi-patch-check"></i>
                        </div>
                        <span class="badge bg-light text-secondary border rounded-pill px-2 py-1 mb-2 align-self-start small">@item.IssueDate.Year</span>
                        <h4 class="fs-6 fw-bold mb-1">@item.Title</h4>
                        <div class="text-secondary small mb-3">@item.Issuer</div>

                        @if (!string.IsNullOrEmpty(item.CertificateUrl))
                        {
                            <div class="mt-auto">
                                <a href="@item.CertificateUrl" target="_blank" rel="noopener noreferrer" class="project-link-btn text-primary">
                                    Sertifikayı Görüntüle <i class="bi bi-arrow-up-right"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>