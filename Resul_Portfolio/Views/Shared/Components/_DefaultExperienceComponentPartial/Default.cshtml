@model List<Experience>
@{
    // Kartlara sırayla verilecek renkler ve zaman çizelgesi ikonları (tasarımdaki gibi döngüsel)
    var badgeColors = new[] { "bg-icon-purple", "bg-icon-blue", "bg-icon-peach" };
    var markerIcons = new[] { "bi-building", "bi-pc-display", "bi-award" };

    // Çalışma türüne göre etiket rengi
    string WorkTypeClass(string workType) => workType switch
    {
        "Tam Zamanlı" => "bg-success-subtle text-success border-success-subtle",
        "Yarı Zamanlı" => "bg-primary-subtle text-primary border-primary-subtle",
        "Staj" => "bg-warning-subtle text-warning border-warning-subtle",
        _ => "bg-secondary-subtle text-secondary border-secondary-subtle"
    };
}

<!-- Work Experience Section -->
<section id="experience">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">PROFESYONEL YOLCULUK</span>
            <h2 class="section-title">Deneyimlerim</h2>
            <p class="section-subtitle">Gerçek dünya problemlerini çözerken edindiğim tecrübeler.</p>
        </div>

        <div class="timeline-container">
            @for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                var isLeft = i % 2 == 0;                       // çift sıradakiler solda, tekler sağda (zigzag)
                var badgeColor = badgeColors[i % badgeColors.Length];
                var markerIcon = markerIcons[i % markerIcons.Length];

                // Açıklama: her satır bir madde
                var duties = item.Description
                .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

                // Etiketler: virgülle ayrılmış
                var tags = string.IsNullOrWhiteSpace(item.Tags)
                ? Array.Empty<string>()
                : item.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

                <div class="timeline-item row align-items-center g-4 reveal-on-scroll">

                    @if (!isLeft)
                    {
                        <!-- Sol: yan bilgi (sadece masaüstü) -->
                        <div class="col-lg-6 timeline-left d-none d-lg-block">
                            <div class="text-secondary small fst-italic">@item.SideTitle</div>
                        </div>
                        <div class="timeline-marker">
                            <i class="bi @markerIcon"></i>
                        </div>
                    }

                    <!-- Deneyim kartı -->
                    <div class="col-lg-6 @(isLeft ? "timeline-left order-2 order-lg-1" : "timeline-right")">
                        <div class="timeline-content-card">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge-year @badgeColor">
                                    <i class="bi bi-briefcase"></i> @item.Duration
                                </span>
                                <span class="badge @WorkTypeClass(item.WorkType) border rounded-pill px-3 py-1 small">@item.WorkType</span>
                            </div>
                            <h4 class="fs-5 fw-bold mb-1">@item.Title</h4>
                            <div class="text-primary fw-semibold small mb-3">@item.CompanyName</div>

                            @if (duties.Length > 1)
                            {
                                <ul class="text-secondary small ps-3 mb-3" style="line-height: 1.6;">
                                    @foreach (var duty in duties)
                                    {
                                        <li>@duty</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-secondary small mb-3">@item.Description</p>
                            }

                            @if (tags.Any())
                            {
                                <div>
                                    @foreach (var tag in tags)
                                    {
                                        <span class="tech-tag">@tag</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @if (isLeft)
                    {
                        <div class="timeline-marker">
                            <i class="bi @markerIcon"></i>
                        </div>
                        <!-- Sağ: yan bilgi (sadece masaüstü) -->
                        <div class="col-lg-6 timeline-right order-1 order-lg-2 d-none d-lg-block">
                            <div class="text-secondary small fst-italic">@item.SideTitle</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>
